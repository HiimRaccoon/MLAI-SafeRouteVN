{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task02-m2-execution-view/2",
  "type": "object",
  "required": [
    "schema_version",
    "basis",
    "execution_mode",
    "real_world_observation",
    "current_time",
    "order_ids",
    "delivered_prefix",
    "planned_served_suffix",
    "unserved",
    "metric_scope",
    "observed_metrics",
    "vehicles",
    "active_job_id",
    "pending_event_ids",
    "planned_suffix_metrics",
    "projected_whole_metrics",
    "accepted_trajectory"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "task02-m2-execution-view/2"
    },
    "basis": {
      "type": "object",
      "required": [
        "session_id",
        "root_sha256",
        "head_sha256",
        "head_version",
        "generation",
        "source_sha256",
        "context_version",
        "overlay_sha256",
        "build_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "root_sha256": {
          "type": "string",
          "minLength": 1
        },
        "head_sha256": {
          "type": "string",
          "minLength": 1
        },
        "head_version": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1
        },
        "context_version": {
          "type": "string",
          "minLength": 1
        },
        "overlay_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_sha256": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution_mode": {
      "const": "SIMULATED_REPLAY"
    },
    "real_world_observation": {
      "const": false
    },
    "current_time": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?\\+07:00$"
    },
    "order_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "delivered_prefix": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "planned_served_suffix": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "unserved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "order_id",
          "reason"
        ],
        "properties": {
          "order_id": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metric_scope": {
      "const": "OBSERVED_PREFIX_ONLY"
    },
    "observed_metrics": {
      "type": [
        "object",
        "null"
      ]
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "active_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "pending_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "planned_suffix_metrics": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "projected_whole_metrics": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "accepted_trajectory": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/trajectory"
        }
      ]
    },
    "delivery_barrier": {
      "type": [
        "string",
        "null"
      ]
    },
    "delivery_day": {
      "type": "object",
      "required": [
        "date",
        "cutoff",
        "catalog",
        "depots",
        "queue",
        "recoveries",
        "confirmations",
        "complete"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "cutoff": {
          "type": "string"
        },
        "catalog": {
          "type": "object"
        },
        "depots": {
          "type": "array"
        },
        "queue": {
          "type": "object"
        },
        "recoveries": {
          "type": "array"
        },
        "confirmations": {
          "type": "object"
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "profile",
        "forecast",
        "domain_sha256",
        "vehicle_routes"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "enum": [
            "FASTEST",
            "BALANCED",
            "SAFER"
          ]
        },
        "forecast": {
          "const": true
        },
        "domain_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "vehicle_routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "vehicle_id",
        "order_sequence",
        "actions",
        "start_us",
        "return_us",
        "start_node",
        "end_node"
      ],
      "properties": {
        "vehicle_id": {
          "type": "string"
        },
        "order_sequence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "start_us": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,18})$"
            }
          ]
        },
        "return_us": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,18})$"
            }
          ]
        },
        "start_node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "end_node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "route_column_id": {
          "type": "string",
          "minLength": 1
        },
        "return_load_kg": {
          "type": "number",
          "minimum": -1e-09
        },
        "total_distance_m": {
          "type": "number",
          "minimum": 0
        },
        "total_travel_time_s": {
          "type": "number",
          "minimum": 0
        },
        "total_exposure": {
          "type": "number",
          "minimum": 0
        },
        "total_cost_vnd": {
          "type": "number",
          "minimum": 0
        },
        "total_soft_lateness_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "kind",
        "start_us",
        "end_us"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "EDGE",
            "PICKUP",
            "WAIT",
            "SERVICE"
          ]
        },
        "start_us": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,18})$"
            }
          ]
        },
        "end_us": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,18})$"
            }
          ]
        },
        "edge_id": {
          "type": "string",
          "minLength": 1
        },
        "incoming_edge": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "to_node": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "node_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "distance_m": {
          "type": "number",
          "minimum": 0
        },
        "exposure": {
          "type": "number",
          "minimum": 0
        },
        "fraction_start": {
          "type": "number",
          "minimum": 0
        },
        "fraction_end": {
          "type": "number",
          "minimum": 0
        },
        "fraction_start_exact": {
          "type": "string"
        },
        "geometry": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "feature_payload": {
          "type": "object"
        },
        "overlay_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "temporal_policy": {
          "type": "string",
          "minLength": 1
        },
        "temporal_segments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "load_after_kg": {
          "type": "number",
          "minimum": -1e-09
        },
        "continuation": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "EDGE"
              }
            }
          },
          "then": {
            "required": [
              "edge_id",
              "from_node",
              "to_node",
              "incoming_edge",
              "fraction_start",
              "fraction_end",
              "geometry",
              "feature_payload",
              "distance_m",
              "exposure"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "PICKUP"
              }
            }
          },
          "then": {
            "required": [
              "order_id",
              "node_id",
              "load_after_kg"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SERVICE"
              }
            }
          },
          "then": {
            "required": [
              "order_id",
              "node_id",
              "load_after_kg"
            ]
          }
        }
      ]
    }
  }
}
