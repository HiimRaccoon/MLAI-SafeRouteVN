# Server environment variables; .env is not loaded automatically.
SAFEROUTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SAFEROUTE_COMPUTE_BUDGET_SECONDS=35
SAFEROUTE_REPLAY_STEP_SECONDS=60
# Defaults resolve to D:\MLAI4\.local\m3-step7 for this installation.
# SAFEROUTE_INSTALLATION_CONFIG=absolute-path-to-installation.json
# SAFEROUTE_AUTH_FILE=absolute-path-to-private-auth_tokens.json
# SAFEROUTE_METADATA_DB=absolute-path-to-private-metadata.sqlite
# SAFEROUTE_WORKER_HEARTBEAT=absolute-path-to-private-worker_heartbeat.json
# Bearer tokens must never be committed here.
# Local Qwen3 explanation (no cloud API key)
SAFEROUTE_OLLAMA_ENABLED=1
SAFEROUTE_OLLAMA_URL=http://127.0.0.1:11434
SAFEROUTE_OLLAMA_MODEL=qwen3:4b
SAFEROUTE_OLLAMA_TIMEOUT_SECONDS=18
